{
  "Jwt": {
    "Issuer": "AmaaraCreations",
    "Audience": "AmaaraCreationsUsers",
    "AccessTokenMinutes": 15
  },
  "Authentication": {
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 21,
    "RequireConfirmedEmail": true,
    "LockoutMinutes": 10,
    "MaxFailedAccessAttempts": 5,
    "RateLimitPermitLimit": 10,
    "RateLimitWindowMinutes": 1,
    "RefreshCookieName": "amaara_refresh",
    "FrontendBaseUrl": "http://localhost:5173"
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Uploads": {
    "MaxFileSizeBytes": 5242880
  },
  "AdminBootstrap": {
    "Enabled": false,
    "Email": "",
    "Password": ""
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}

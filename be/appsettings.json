{
  "$schema": "https://json.schemastore.org/appsettings.json",
  "Administration": {
    "Enabled": false,
    "AllowedOrigins": []
  },
  "Jwt": {
    "Issuer": "AmaaraCreations",
    "Audience": "AmaaraCreationsUsers",
    "AccessTokenMinutes": 15
  },
  "Authentication": {
    "RequirePasswordBlocklist": false,
    "PasswordBlocklistPath": "",
    "EmailChangeEnabled": false,
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 21,
    "RequireConfirmedEmail": true,
    "LockoutMinutes": 10,
    "MaxFailedAccessAttempts": 5,
    "RateLimitPermitLimit": 10,
    "RateLimitWindowMinutes": 1,
    "RefreshCookieName": "amaara_refresh",
    "FrontendBaseUrl": "http://localhost:5173"
  },
  "Email": {
    "Host": "smtp.gmail.com",
    "Port": 587,
    "EnableSsl": true,
    "FromName": "Amaara Creations",
    "FromEmail": "noreply@amaaracreations.com"
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "CustomerRequests": { "QuotesEnabled": false },
  "Privacy": { "RequestsEnabled": false },
  "Uploads": {
    "Scanner": { "Enabled": false, "Required": false, "Endpoint": "" },
    "MaxFileSizeBytes": 5242880,
    "MaxImagePixels": 24000000
  },
  "AdminBootstrap": {
    "Enabled": false,
    "Email": "",
    "Password": ""
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Checkout": {
    "Currency": "LKR",
    "InventoryReservationMinutes": 35,
    "ReconciliationSeconds": 30,
    "TaxRate": 0,
    "PricesIncludeTax": false,
    "TaxShipping": false,
    "PaymentFeeFixed": 0,
    "PaymentFeePercentage": 0,
    "AllowDevelopmentShipping": false
  },
  "Datatrans": {
    "Enabled": false,
    "Environment": "Sandbox",
    "ApiVersion": "v1",
    "AutoSettle": true,
    "VerifiedCurrencies": [],
    "PaymentMethods": [],
    "TimeoutSeconds": 15,
    "SignatureToleranceSeconds": 300
  },
  "Zahls": {
    "Enabled": false,
    "Mode": "TEST",
    "ApiBaseUrl": "https://api.zahls.ch",
    "ApiVersion": "v1.16",
    "Currency": "CHF",
    "PaymentMethods": [],
    "TestProviderConfigured": false,
    "ChfSupportedByTestProvider": false,
    "TimeoutSeconds": 15
  }
}

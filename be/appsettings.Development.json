{
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=AmaaraCreationsDB;Trusted_Connection=true;TrustServerCertificate=true;"
  },
  "Jwt": {
    "Key": "DevelopmentOnlyJwtSigningKey-Change-With-User-Secrets",
    "Issuer": "AmaaraCreations",
    "Audience": "AmaaraCreationsUsers",
    "AccessTokenMinutes": 15
  },
  "Authentication": {
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 21,
    "RequireConfirmedEmail": true,
    "LockoutMinutes": 10,
    "MaxFailedAccessAttempts": 5,
    "RateLimitPermitLimit": 30,
    "RateLimitWindowMinutes": 1,
    "RefreshCookieName": "amaara_refresh",
    "FrontendBaseUrl": "http://localhost:5173"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "http://127.0.0.1:5173"
    ]
  },
  "AdminBootstrap": {
    "Enabled": false,
    "Email": "",
    "Password": ""
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Information"
    }
  }
}

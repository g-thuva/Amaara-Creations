{
  "Storage": {
    "Provider": "S3",
    "LegacyLocalReadsEnabled": false,
    "AllowLocalInProduction": false,
    "LegacyPublicOrigins": ["http://localhost:5192", "http://127.0.0.1:5192"],
    "OrphanGraceHours": 168,
    "Limits": { "AvatarBytes": 5242880, "ProductBytes": 5242880, "ArtworkBytes": 5242880, "ProofBytes": 5242880 },
    "S3": {
      "Region": "ap-south-1",
      "PublicBucket": "amaara-dev-public-replace-with-unique-suffix",
      "PrivateBucket": "amaara-dev-private-replace-with-unique-suffix",
      "PublicDelivery": "ApiProxy",
      "PublicBaseUrl": "",
      "Prefixes": { "Avatars": "avatars", "Products": "products", "Artwork": "custom-artwork", "Proofs": "custom-proofs" },
      "PrivateDownloadExpirySeconds": 60,
      "ReadinessPublicKey": "",
      "ReadinessPrivateKey": ""
    }
  },
  "Uploads": { "MaxFileSizeBytes": 5242880, "MaxImagePixels": 24000000, "Scanner": { "Enabled": false, "Required": false, "Endpoint": "" } }
}

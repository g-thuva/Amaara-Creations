# Render every {{PLACEHOLDER}} before validating. This is never an active config.
# Public certificates, domain, directories and upstream require owner approval.
log_format amaara_safe '$request_id $request_method $uri $status $request_time';
server {
    listen 80;
    server_name {{APP_HOST}};
    return 308 https://{{APP_HOST}}$request_uri;
}
server {
    listen 443 ssl;
    server_name {{APP_HOST}};
    ssl_certificate {{TLS_CERTIFICATE_FILE}};
    ssl_certificate_key {{TLS_PRIVATE_KEY_FILE}};
    ssl_protocols TLSv1.2 TLSv1.3;
    root {{WEB_ROOT}};
    index index.html;
    access_log {{ACCESS_LOG_FILE}} amaara_safe;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $remote_addr;
    client_max_body_size 6m;
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/css application/javascript application/json image/svg+xml;
    include {{SECURITY_HEADERS_FILE}};

    location /api/ {
        proxy_pass {{API_LOOPBACK_ORIGIN}};
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_buffering off;
        proxy_cache off;
    }
    location = /health/ready { proxy_pass {{API_LOOPBACK_ORIGIN}}; }
    location = /health/live { proxy_pass {{API_LOOPBACK_ORIGIN}}; }
    location = /robots.txt { proxy_pass {{API_LOOPBACK_ORIGIN}}/api/v1/seo/robots.txt; }
    location = /sitemap.xml { proxy_pass {{API_LOOPBACK_ORIGIN}}/api/v1/seo/sitemap.xml; }
    location /uploads/ {
        alias {{PUBLIC_MEDIA_DIRECTORY}}/;
    }
    location /App_Data/ { deny all; }
    location ~ /\. { deny all; }
    location /assets/ {
        try_files $uri =404;
        expires 1y;
        add_header Cache-Control 'public, immutable';
        include {{SECURITY_HEADERS_FILE}};
    }
    location = /index.html { add_header Cache-Control 'no-cache'; include {{SECURITY_HEADERS_FILE}}; }
    location / { try_files $uri $uri/ /index.html; }
}

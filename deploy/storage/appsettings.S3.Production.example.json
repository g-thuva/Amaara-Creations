{
  "Storage": {
    "Provider": "S3",
    "AllowLocalInProduction": false,
    "LegacyLocalReadsEnabled": false,
    "LegacyPublicOrigins": [],
    "OrphanGraceHours": 168,
    "Limits": { "AvatarBytes": 5242880, "ProductBytes": 5242880, "ArtworkBytes": 5242880, "ProofBytes": 5242880 },
    "S3": {
      "Region": "ap-south-1",
      "PublicBucket": "amaara-prod-public-replace-with-unique-suffix",
      "PrivateBucket": "amaara-prod-private-replace-with-unique-suffix",
      "PublicDelivery": "CloudFront",
      "PublicBaseUrl": "https://replace-with-approved-cdn.example",
      "Prefixes": { "Avatars": "avatars", "Products": "products", "Artwork": "custom-artwork", "Proofs": "custom-proofs" },
      "PrivateDownloadExpirySeconds": 60,
      "ReadinessPublicKey": "s3:public/products/2026/10/00000000000000000000000000000000.png",
      "ReadinessPrivateKey": "s3:private/custom-proofs/1/2026/10/00000000000000000000000000000000.png"
    }
  }
}
